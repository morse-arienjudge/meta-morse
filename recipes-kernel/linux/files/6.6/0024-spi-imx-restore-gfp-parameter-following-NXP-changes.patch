From 65ce4085cf79d526d7783e912e3839a67b99a958 Mon Sep 17 00:00:00 2001
From: Arien Judge <arien.judge@morsemicro.com>
Date: Thu, 26 Jun 2025 13:09:42 +1000
Subject: [PATCH] spi: imx: restore gfp parameter following NXP changes

---
 drivers/spi/spi-imx.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/spi/spi-imx.c b/drivers/spi/spi-imx.c
index 81ebf4ce7fc3..5930a85c76b1 100644
--- a/drivers/spi/spi-imx.c
+++ b/drivers/spi/spi-imx.c
@@ -563,7 +563,7 @@ static int mx51_ecspi_prepare_message(struct spi_imx_data *spi_imx,
 
 	if (use_dma_dynamic_burst) {
 		ret = spi_split_transfers_maxsize(spi_imx->controller, msg,
-						  MX51_ECSPI_CTRL_MAX_BURST);
+						  MX51_ECSPI_CTRL_MAX_BURST, GFP_KERNEL | GFP_DMA);
 		if (ret)
 			return ret;
 	}
