From 982d9501431b8d30eda3e3afbd25e2826f8de2d8 Mon Sep 17 00:00:00 2001
From: Arien Judge <arien.judge@morsemicro.com>
Date: Thu, 26 Jun 2025 12:57:09 +1000
Subject: [PATCH 11/15] Revert "LF-8808 spi: imx: fix message endian convert in
 target dma tx buffer"

This reverts commit 74f4e466ff42275f990367ca553d670b0c97b2e9.
---
 drivers/spi/spi-imx.c | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/drivers/spi/spi-imx.c b/drivers/spi/spi-imx.c
index 9087d09b7d9c..1eb32392506c 100644
--- a/drivers/spi/spi-imx.c
+++ b/drivers/spi/spi-imx.c
@@ -632,12 +632,6 @@ static int mx51_ecspi_prepare_message(struct spi_imx_data *spi_imx,
 		testreg &= ~MX51_ECSPI_TESTREG_LBC;
 	writel(testreg, spi_imx->base + MX51_ECSPI_TESTREG);
 
-	list_for_each_entry(xfer, &msg->transfers, transfer_list) {
-		if (spi_imx->target_mode &&
-		    spi_imx_can_dma(spi_imx->controller, spi, xfer))
-			spi_imx_target_dma_convert(xfer, DMA_TO_DEVICE);
-	};
-
 	/*
 	 * eCSPI burst completion by Chip Select signal in Target mode
 	 * is not functional for imx53 Soc, config SPI burst completed when
@@ -689,6 +683,10 @@ static int mx51_ecspi_prepare_message(struct spi_imx_data *spi_imx,
 	 * min_speed_hz is ~0 and the resulting delay is zero.
 	 */
 	list_for_each_entry(xfer, &msg->transfers, transfer_list) {
+		if (spi_imx->target_mode &&
+		    spi_imx_can_dma(spi_imx->controller, spi, xfer))
+			spi_imx_target_dma_convert(xfer, DMA_TO_DEVICE);
+
 		if (!xfer->speed_hz)
 			continue;
 		min_speed_hz = min(xfer->speed_hz, min_speed_hz);
-- 
2.25.1

