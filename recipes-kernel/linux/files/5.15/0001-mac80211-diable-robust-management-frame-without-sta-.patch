From db4cec83d72a835c77440a0cf9b4ddde3e5bbb28 Mon Sep 17 00:00:00 2001
From: Arien Judge <arien.judge@morsemicro.com>
Date: Tue, 19 Nov 2024 12:19:13 +1100
Subject: [PATCH 1/7] mac80211: diable robust management frame without sta
 check

---
 net/mac80211/rx.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/net/mac80211/rx.c b/net/mac80211/rx.c
index 175ead6b19cb..c3e453e5a571 100644
--- a/net/mac80211/rx.c
+++ b/net/mac80211/rx.c
@@ -4125,8 +4125,10 @@ static bool ieee80211_accept_frame(struct ieee80211_rx_data *rx)
 	case NL80211_IFTYPE_STATION:
 		if (!bssid && !sdata->u.mgd.use_4addr)
 			return false;
+#if 0
 		if (ieee80211_is_robust_mgmt_frame(skb) && !rx->sta)
 			return false;
+#endif
 		if (multicast)
 			return true;
 		return ether_addr_equal(sdata->vif.addr, hdr->addr1);
-- 
