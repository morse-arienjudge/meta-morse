From 4c4ad29d12234bff7f90826371b3ae8931668f57 Mon Sep 17 00:00:00 2001
From: Arien Judge <arien.judge@morsemicro.com>
Date: Tue, 26 Nov 2024 18:11:15 +1100
Subject: [PATCH 1/3] arm: dts: replace broadcom node with morse. Disable SD
 and 1.8V

---
 arch/arm/boot/dts/imx6ul-imx6ull-var-dart-wifi.dtsi | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/imx6ul-imx6ull-var-dart-wifi.dtsi b/arch/arm/boot/dts/imx6ul-imx6ull-var-dart-wifi.dtsi
index 43f670af7525..b6af51740c04 100644
--- a/arch/arm/boot/dts/imx6ul-imx6ull-var-dart-wifi.dtsi
+++ b/arch/arm/boot/dts/imx6ul-imx6ull-var-dart-wifi.dtsi
@@ -75,10 +75,13 @@ &usdhc1 {
 	fsl,tuning-step = <2>;
 	keep-power-in-suspend;
 	vmmc-supply = <&reg_sd1_vmmc>;
+	no-1-8-v;
+	no-sd;
 	status = "okay";
 
-	brcmf: bcrmf@1 {
-		reg = <1>;
-		compatible = "brcm,bcm4329-fmac";
+	mm6108: mm6108@1 {
+		reg = <2>;
+		compatible = "morse,mm610x";
+		status = "okay";
 	};
 };
-- 
2.25.1

