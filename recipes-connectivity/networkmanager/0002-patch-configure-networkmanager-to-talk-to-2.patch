+/**
+ * Simple helper function to determine if the interface path is an S1G target
+ */
+bool is_path_s1g(const char* path){
+  const char* search_target = "s1g";
+    for(size_t i = 0; i < strlen(path) - strlen(search_target); i++){
+      if(strncmp(path+i,search_target, strlen(search_target)) == 0){
+        return true;
+      }
+    }
+    return false;
+}
