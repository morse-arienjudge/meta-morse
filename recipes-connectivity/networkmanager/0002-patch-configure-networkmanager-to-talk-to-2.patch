+static bool is_iface_mm(const char *ifname){
+      char path[PATH_MAX];
+      char buf[PATH_MAX];
+      sprintf(path, "/sys/class/net/%s/device/driver", ifname);
+      ssize_t len = readlink(path, buf, sizeof(buf) - 1);
+      if (len == -1) {
+          return false;
+      }
+      buf[len] = '\0';  // Null-terminate the buffer
+      const char* MM = "morse";
+      for(int i = 0; i < len; i++){
+        int cmp = strncmp(buf+i, MM, strlen(MM));
+        if (cmp == 0){
+          return true;
+        }
+      }
+      return false;
+}
